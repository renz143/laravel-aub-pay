{
    "name": "prycegas/laravel-aub-pay",
    "description": "Laravel client for the AUB (Asia United Bank) payment APIs \u2014 Card Cashier, direct card, and QR/e-wallet rails.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "payments",
        "aub",
        "wallyt",
        "wepayez",
        "philippines"
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-simplexml": "*",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "web-token/jwt-library": "^3.3|^4.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "suggest": {
        "phpseclib/phpseclib": "Required only for the direct card rail (/online/v1/*), which JWE-encrypts PAN and CVV with RSA-OAEP-256 \u2014 an algorithm PHP's openssl extension cannot produce. The Cashier and wallet rails do not need it.",
        "web-token/jwt-library": "An alternative JWE provider for the direct card rail. Needs PHP 8.2+; phpseclib is the default because it works on 8.1 too."
    },
    "autoload": {
        "psr-4": {
            "Prycegas\\AubPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prycegas\\AubPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Prycegas\\AubPay\\AubPayServiceProvider"
            ],
            "aliases": {
                "AubPay": "Prycegas\\AubPay\\Facades\\AubPay"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
